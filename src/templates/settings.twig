{% js %}
(function() {
    function post(action, body) {
        return Craft.sendActionRequest('POST', action, { data: body || {} });
    }

    function get(action, params) {
        return Craft.sendActionRequest('GET', action, { params: params || {} });
    }

    function say(id, message, isError) {
        var el = document.getElementById(id);
        if (!el) { return; }
        el.textContent = message;
        el.style.color = isError ? '#cf1124' : '';
    }

    function listModal(title, options) {
        var modal = document.createElement('div');
        modal.className = 'modal';
        modal.style.cssText = 'padding: 24px; overflow: auto; max-height: 70vh;';

        var heading = document.createElement('h2');
        heading.textContent = title;
        modal.appendChild(heading);

        var table = document.createElement('table');
        table.className = 'data fullwidth';
        options.forEach(function(option) {
            var row = table.insertRow();
            var id = row.insertCell();
            // Values arrive as data and are set as text: an administration named with a `<script>`
            // is a bad joke, not a stored XSS.
            id.textContent = option.value;
            id.style.fontFamily = 'monospace';
            row.insertCell().textContent = option.label;
        });
        modal.appendChild(table);

        document.body.appendChild(modal);
        new Garnish.Modal(modal, { resizable: true });
    }

    var test = document.getElementById('bird-test');
    if (test) {
        test.addEventListener('click', function() {
            test.classList.add('loading');
            say('bird-test-result', {{ 'Asking Moneybird…'|t('bird')|json_encode|raw }});
            get('bird/settings/test-connection')
                .then(function(response) { say('bird-test-result', response.data.message, !response.data.success); })
                .catch(function() { say('bird-test-result', {{ 'Couldn’t reach Moneybird.'|t('bird')|json_encode|raw }}, true); })
                .finally(function() { test.classList.remove('loading'); });
        });
    }

    var administrations = document.getElementById('bird-administrations');
    if (administrations) {
        administrations.addEventListener('click', function() {
            get('bird/settings/administrations').then(function(response) {
                if (!response.data.success) { say('bird-test-result', response.data.message, true); return; }
                listModal({{ 'Administrations'|t('bird')|json_encode|raw }}, response.data.options);
            });
        });
    }

    [['bird-list-tax', 'taxRates', {{ 'Moneybird tax rates'|t('bird')|json_encode|raw }}],
     ['bird-list-ledger', 'ledgerAccounts', {{ 'Moneybird ledger accounts'|t('bird')|json_encode|raw }}]].forEach(function(entry) {
        var button = document.getElementById(entry[0]);
        if (!button) { return; }
        button.addEventListener('click', function() {
            button.classList.add('loading');
            get('bird/settings/options', { type: entry[1] })
                .then(function(response) {
                    if (!response.data.success) { Craft.cp.displayError(response.data.message); return; }
                    listModal(entry[2], response.data.options);
                })
                .finally(function() { button.classList.remove('loading'); });
        });
    });

    var suggest = document.getElementById('bird-suggest-tax');
    if (suggest) {
        suggest.addEventListener('click', function() {
            suggest.classList.add('loading');
            get('bird/settings/suggest-tax-rates')
                .then(function(response) {
                    if (!response.data.success) { Craft.cp.displayError(response.data.message); return; }
                    var lines = response.data.rows.map(function(row) {
                        return row.percentage + '%  ' + row.taxRateId + '  ' + row.label;
                    });
                    if (response.data.reverseCharge) {
                        lines.push('reverse charge  ' + response.data.reverseCharge.value + '  ' + response.data.reverseCharge.label);
                    }
                    if (response.data.export) {
                        lines.push('export  ' + response.data.export.value + '  ' + response.data.export.label);
                    }
                    listModal({{ 'Suggested mapping — copy these into the tables above'|t('bird')|json_encode|raw }},
                        lines.map(function(line) { return { value: '', label: line }; }));
                })
                .finally(function() { suggest.classList.remove('loading'); });
        });
    }

    var install = document.getElementById('bird-install-webhook');
    if (install) {
        install.addEventListener('click', function() {
            install.classList.add('loading');
            post('bird/settings/install-webhook')
                .then(function(response) {
                    say('bird-webhook-result', response.data.message, !response.data.success);
                    if (response.data.success) { Craft.cp.displayNotice(response.data.message); }
                })
                .catch(function() { say('bird-webhook-result', {{ 'Couldn’t install the webhook.'|t('bird')|json_encode|raw }}, true); })
                .finally(function() { install.classList.remove('loading'); });
        });
    }

    var remove = document.getElementById('bird-remove-webhook');
    if (remove) {
        remove.addEventListener('click', function() {
            remove.classList.add('loading');
            post('bird/settings/remove-webhook')
                .then(function(response) { say('bird-webhook-result', response.data.message, !response.data.success); })
                .finally(function() { remove.classList.remove('loading'); });
        });
    }
})();
{% endjs %}
