{# Field names carry no `settings[…]` prefix: `craft\base\Plugin::settingsResponse()` runs this
   template's output through `View::namespaceInputs(…, 'settings')`, so a name written as
   `settings[foo]` here posts as `settings[settings][foo]` and saves nothing at all — the screen
   looks perfect, Craft says "Plugin settings saved", and every edit is silently discarded. #}
{% import '_includes/forms' as forms %}

{# Pro-only fields are shown and saved on Lite rather than disabled. Craft persists only the keys
   a save actually posts (`Plugins::savePluginSettings()` calls `toArray(array_keys($settings))`),
   so a disabled input drops its setting out of project config altogether. The runtime gates every
   Pro feature on `isPro()` anyway, and settings kept now are settings that work on upgrade. #}
{% set isPro = plugin.isPro() %}
{% set commerceReady = craft.app.plugins.isPluginEnabled('commerce') %}
{% set statusOptions = commerceReady ? craft.bird.orderStatusOptions() : [] %}

{% set taxRows = [] %}
{% for percentage, taxRateId in settings.getTaxRateMap() %}
    {% set taxRows = taxRows|merge([{ percentage: percentage, taxRateId: taxRateId }]) %}
{% endfor %}

{% set ossRows = [] %}
{% for key, taxRateId in settings.getOssTaxRateMap() %}
    {% set ossRows = ossRows|merge([{ key: key, taxRateId: taxRateId }]) %}
{% endfor %}

{% set ledgerRows = [] %}
{% for productType, ledgerAccountId in settings.getLedgerAccountMap() %}
    {% set ledgerRows = ledgerRows|merge([{ productType: productType, ledgerAccountId: ledgerAccountId }]) %}
{% endfor %}

{% if not commerceReady %}
    <div class="pane">
        <p class="error">{{ 'Craft Commerce is not installed or enabled. Bird needs it to do anything.'|t('bird') }}</p>
    </div>
{% endif %}

{% if not isPro %}
    <div class="pane" style="border-left: 3px solid #cdd8e4;">
        <p>
            <strong>{{ 'You’re running Bird Lite.'|t('bird') }}</strong>
            {{ 'The connection log, One Stop Shop tax rates, per-product-type ledger accounts, credit notes for refunds, sending invoices from Moneybird and the paid-invoice webhook are Pro features. Their settings are shown below but have no effect until you upgrade.'|t('bird') }}
        </p>
    </div>
{% endif %}

