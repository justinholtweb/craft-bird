{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = 'Connection log'|t('bird') %}
{% set selectedSubnavItem = 'log' %}

{% block actionButton %}
    <button type="button" class="btn" id="bird-prune">{{ 'Prune old entries'|t('bird') }}</button>
{% endblock %}

{% block content %}
    <div class="flex" style="margin-bottom: 14px; gap: 10px;">
        {{ forms.select({
            id: 'bird-action-filter',
            name: 'action_filter',
            options: [
                { label: 'All actions'|t('bird'), value: '' },
                { label: 'API'|t('bird'), value: 'api' },
                { label: 'Invoice'|t('bird'), value: 'invoice' },
                { label: 'Credit'|t('bird'), value: 'credit' },
                { label: 'Contact'|t('bird'), value: 'contact' },
                { label: 'Payment'|t('bird'), value: 'payment' },
                { label: 'Webhook'|t('bird'), value: 'webhook' }
            ],
            value: criteria.action ?? ''
        }) }}

        {{ forms.select({
            id: 'bird-level-filter',
            name: 'level',
            options: [
                { label: 'All levels'|t('bird'), value: '' },
                { label: 'Info'|t('bird'), value: 'info' },
                { label: 'Warning'|t('bird'), value: 'warning' },
                { label: 'Error'|t('bird'), value: 'error' }
            ],
            value: criteria.level ?? ''
        }) }}

        <span class="light" style="align-self: center;">{{ '{total} entries'|t('bird', { total: total }) }}</span>
    </div>

    {% if entries|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'When'|t('bird') }}</th>
                    <th scope="col">{{ 'Action'|t('bird') }}</th>
                    <th scope="col">{{ 'Status'|t('bird') }}</th>
                    <th scope="col">{{ 'Time'|t('bird') }}</th>
                    <th scope="col">{{ 'Summary'|t('bird') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr>
                        <td class="nowrap"><a href="{{ url('bird/log/' ~ entry.id) }}">{{ entry.dateCreated ? entry.dateCreated|datetime('short') : '—' }}</a></td>
                        <td>{{ entry.action }}</td>
                        <td>
                            <span class="status {{ entry.level == 'error' ? 'red' : (entry.level == 'warning' ? 'orange' : 'green') }}"></span>
                            {{ entry.statusCode ?? '—' }}
                        </td>
                        <td class="light">{{ entry.durationMs is not null ? entry.durationMs ~ 'ms' : '—' }}</td>
                        <td>{{ entry.summary ?? '' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="zilch">
            <p>{{ 'Nothing logged yet.'|t('bird') }}</p>
            <p class="light">{{ 'Every call Bird makes to Moneybird, and every webhook it receives, shows up here.'|t('bird') }}</p>
        </div>
    {% endif %}
{% endblock %}

{% js %}
(function() {
    function reload() {
        var url = new URL(window.location.href);
        var action = document.getElementById('bird-action-filter');
        var level = document.getElementById('bird-level-filter');

        if (action && action.value) { url.searchParams.set('action_filter', action.value); }
        else { url.searchParams.delete('action_filter'); }

        if (level && level.value) { url.searchParams.set('level', level.value); }
        else { url.searchParams.delete('level'); }

        window.location.href = url.toString();
    }

    ['bird-action-filter', 'bird-level-filter'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) { el.addEventListener('change', reload); }
    });

    var prune = document.getElementById('bird-prune');
    if (prune) {
        prune.addEventListener('click', function() {
            Craft.sendActionRequest('POST', 'bird/log/prune')
                .then(function(response) {
                    Craft.cp.displayNotice(response.data.message);
                    window.location.reload();
                })
                .catch(function() { Craft.cp.displayError({{ 'Couldn’t prune the log.'|t('bird')|json_encode|raw }}); });
        });
    }
})();
{% endjs %}
