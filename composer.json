{
    "name": "justinholtweb/craft-bird",
    "description": "Moneybird bookkeeping for Craft Commerce — turn paid orders into Moneybird invoices with EU-correct VAT, keep contacts in sync, register payments and credit refunds.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "commerce",
        "moneybird",
        "accounting",
        "bookkeeping",
        "invoices",
        "vat",
        "btw",
        "eu"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0",
        "craftcms/commerce": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\bird\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Bird",
        "handle": "bird",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-bird/blob/main/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-bird/main/CHANGELOG.md",
        "class": "justinholtweb\\bird\\Plugin"
    }
}
